<?xml version="1.0" encoding="utf-8"?>

<configuration>
    <packageSources>
        <!-- Remove default feeds -->
        <!-- <clear /> -->

        <!-- Feed for private prerelease packages -->
        <add key="DevelopmentLocal" value="%DEV_LOCAL_NUGET_FEED_URL%" />

        <!-- Feed for private release (production ready) packages -->
        <add key="Personal" value="%PERSONAL_NUGET_FEED_URL%" />

    </packageSources>

    <!-- Credentials for private feeds. API keys are stored as environment variables -->
    <packageSourceCredentials>        
        <Release>
            <add key="Username" value="%PERSONAL_NUGET_FEED_USERNAME%" />
            <add key="ClearTextPassword" value="%PERSONAL_NUGET_FEED_PAT%" />
        </Release>
    </packageSourceCredentials>
</configuration>